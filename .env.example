# Copie ce fichier en ".env" puis remplis-le. Le fichier .env n'est JAMAIS envoye sur GitHub.

# --- Boite mail d'envoi (Gmail par defaut) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
# Mot de passe d'application Google (16 caracteres), PAS ton mot de passe habituel.
# myaccount.google.com > Securite > Validation en 2 etapes > Mots de passe des applications
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Lecture de la boite (bouton "Verifier inbox" : reponses et bounces) ---
IMAP_HOST=imap.gmail.com

# --- Nom affiche comme expediteur (sinon : prenom + nom du Profil) ---
SENDER_NAME=Prenom Nom

# --- Rythme d'envoi ---
SEND_DELAY_SECONDS=20
DAILY_SEND_LIMIT=100

# --- Relances ---
FOLLOWUP_DELAY_DAYS=5
FOLLOWUP_MAX=3

# --- Securite des formulaires (une longue chaine aleatoire) ---
# Genere-la avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi
